# 원본(source) Supabase 프로젝트 — anon 모드에서는 브라우저가 이 값으로 행을 읽습니다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# (선택) service_role (env) 모드 — RLS를 우회해 모든 행을 서버에서 읽습니다.
# - 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요 (브라우저 번들에 포함됨).
# - 이 키는 위 NEXT_PUBLIC_SUPABASE_URL 로만 전송됩니다.
# - 사용하려면 화면에서 Supabase 계정(PAT)으로 로그인해야 하며, 그 계정이 원본 프로젝트에 접근할 수 있어야 합니다.
# SUPABASE_SERVICE_ROLE_KEY=

# (선택) 원본 URL이 *.supabase.co 가 아닐 때(자체 호스팅/로컬) env 모드를 계정 확인 없이 허용합니다.
# 켜면 이 앱에 접근할 수 있는 누구나 원본 DB 전체를 읽을 수 있습니다. 로컬에서만 사용하세요.
# ALLOW_UNVERIFIED_SERVICE_ROLE=true
